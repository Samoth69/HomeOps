---
machine:
  type: controlplane
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/metal-installer-secureboot/6b2c02d613bc5a13617cb5a2939aaef295eb796d0310644adc2edd818b3d4014:v1.14.1
provisioning:
  diskSelector:
    match: disk.model == "INTEL SSDSC2BB96"
  wipe: false
---
apiVersion: v1alpha1
kind: SysfsConfig
params:
  devices.system.cpu.cpufreq.boost: "1"
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - enp3s0
bondMode: active-backup
addresses:
  - address: {{ ENV.TALSECRET_CUSTOM_LYNKA_IPV4 }}/24
  - address: {{ ENV.TALSECRET_CUSTOM_LYNKA_IPV6 }}/64
routes:
  - gateway: "192.168.0.1"
  - gateway: "fe80::2266:cfff:fe83:760a"
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: lynka
auto: off